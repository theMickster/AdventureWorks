{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ConnectionStrings": {
    "AdventureWorks": "Server=MySqlServer;Database=AdventureWorks;",
    "AdventureWorks_E2E": "Server=MySqlServer;Database=AdventureWorks_E2E;",
    "AdventureWorks_Load": "Server=MySqlServer;Database=AdventureWorks_Load;",
    "AdventureWorks_Integration": "Server=MySqlServer;Database=AdventureWorks_Integration;"
  },
  "DbReset": {
    "SnapshotSource": "AdventureWorks",
    "DefaultTarget": "AdventureWorks_Load",
    "BaselinePath": "tools/console-apps/AdventureWorks.DbReset.Console/baselines/AdventureWorks_baseline.bak",
    "TargetNamePattern": "^AdventureWorks_(E2E|Test|Load|Integration)([A-Za-z0-9_]*)?$",
    "DbUpProjectPath": "database/dbup/AdventureWorks.DbUp",
    "SourceMarker": {
      "Property": "dbreset.role",
      "Value": "source"
    }
  }
}
