									"    pm.expect(body).to.have.property(\"poCount\");",
									"    pm.expect(body).to.have.property(\"avgPoValue\");",
									"});",
									"",
									"pm.test(\"vendorId matches the requested id\", function () {",
									"    pm.expect(body.vendorId).to.eql(1496);",
									"});",
									"",
									"pm.test(\"avgPoValue is consistent with totalSpend / poCount\", function () {",
									"    if (body.poCount === 0) {",
									"        pm.expect(body.avgPoValue).to.eql(0);",
									"    } else {",
									"        pm.expect(body.avgPoValue).to.be.closeTo(body.totalSpend / body.poCount, 0.01);",
									"    }",
									"});"
								],
