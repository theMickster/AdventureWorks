									"pm.test(\"Response has vendor detail shape\", function () {",
									"    pm.expect(body).to.have.property(\"vendorId\");",
									"    pm.expect(body).to.have.property(\"name\");",
									"    pm.expect(body).to.have.property(\"accountNumber\");",
									"    pm.expect(body).to.have.property(\"creditRatingLabel\");",
