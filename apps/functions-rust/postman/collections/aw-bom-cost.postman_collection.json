{
	"info": {
		"_postman_id": "580b6a63-53a7-4a81-83c8-0c2f0f9cb923",
		"name": "AW BOM Cost",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Postman collection for apps/functions-rust (Feature 609, Epic #569): BOM cost explosion and manufacturing feasibility. Authenticates with a Functions key (?code=), like apps/functions-dotnet; locally the key is not enforced. Run the requests in order: the cache-hit request relies on the baseline request before it."
	},
