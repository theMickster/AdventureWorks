								"exec": [
									"pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
									"// Run directly after 'Get BOM Cost (baseline)' with the same quantity.",
									"pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"X-Cache is hit\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"hit\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Cache-Control",
								"value": "max-age=60",
								"description": "Postman adds Cache-Control: no-cache to every request by default, which would bypass the cache. Any value other than no-cache lets the cache serve the request."
							}
						],
						"url": {
							"raw": "{{functionsBaseUrl}}/bom-cost/{{productId}}?quantity={{quantity}}&code={{functionKey}}",
