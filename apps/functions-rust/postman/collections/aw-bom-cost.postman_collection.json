				{
					"name": "Get BOM Cost (what-if price override)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
									"pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"X-Cache is skipped (what-if is never cached)\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"skipped\"));",
									"const body = pm.response.json();",
									"pm.test(\"What-if block has a delta from baseline\", () => { pm.expect(body.whatIf.baselineUnit.total).to.be.a(\"number\"); pm.expect(body.whatIf.deltaUnit.total).to.be.a(\"number\"); });",
									"pm.test(\"Unit total equals baseline plus delta\", () => pm.expect(body.unitCost.total).to.be.closeTo(body.whatIf.baselineUnit.total + body.whatIf.deltaUnit.total, 0.001));",
									"pm.test(\"Override was applied or explained\", () => pm.expect(body.whatIf.applied.length + body.whatIf.ignored.length).to.eql(1));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Cache-Control",
								"value": "max-age=60",
								"description": "Postman adds Cache-Control: no-cache to every request by default, which would bypass the cache. Any value other than no-cache lets the cache serve the request."
							}
						],
						"url": {
							"raw": "{{functionsBaseUrl}}/bom-cost/{{productId}}?quantity={{quantity}}&override={{overrideComponentId}}:{{overridePrice}}&code={{functionKey}}",
							"host": [
