				{
					"name": "Get BOM Cost (shortage)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
									"// Default productId 771 and shortageQuantity 9 exceed the aggregate stock of Paint - Silver (65 on hand, 8 per bike).",
									"pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
									"const feasibility = pm.response.json().feasibility;",
									"pm.test(\"Not feasible and shortages are reported\", () => { pm.expect(feasibility.feasible).to.be.false; pm.expect(feasibility.shortages.length).to.be.above(0); });",
									"pm.test(\"Shortage deficit is required minus available\", () => feasibility.shortages.forEach(s => pm.expect(s.deficit).to.be.closeTo(s.required - s.available, 0.0001)));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Cache-Control",
								"value": "no-cache"
