								"type": "text/javascript",
								"exec": [
									"pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
									"pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"X-Cache is refresh\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"refresh\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Cache-Control",
								"value": "no-cache"
							}
						],
						"url": {
							"raw": "{{functionsBaseUrl}}/bom-cost/{{productId}}?quantity={{quantity}}&code={{functionKey}}",
							"host": [
								"{{functionsBaseUrl}}"
							],
							"path": [
								"bom-cost",
								"{{productId}}"
							],
							"query": [
								{
