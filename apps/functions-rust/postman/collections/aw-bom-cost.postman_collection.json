			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"item": [
		{
			"name": "BOM Cost",
			"item": [
				{
					"name": "Get BOM Cost (baseline)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
									"pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Correlation id in body matches header\", () => pm.expect(body.correlationId).to.eql(pm.response.headers.get(\"X-Correlation-Id\")));",
									"pm.test(\"Cost breakdown adds up\", () => pm.expect(body.unitCost.total).to.be.closeTo(body.unitCost.material + body.unitCost.labor, 0.0001));",
									"pm.test(\"Batch cost is unit cost times quantity\", () => pm.expect(body.batchCost.total).to.be.closeTo(body.unitCost.total * body.quantity, 0.001));",
									"pm.test(\"Tree root is the requested product\", () => pm.expect(body.tree.productId).to.eql(Number(pm.collectionVariables.get(\"productId\"))));",
									"pm.test(\"Feasibility reports a flag and shortages array\", () => { pm.expect(body.feasibility.feasible).to.be.a(\"boolean\"); pm.expect(body.feasibility.shortages).to.be.an(\"array\"); });",
									"pm.test(\"No what-if block on a baseline request\", () => pm.expect(body.whatIf).to.be.undefined);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Cache-Control",
								"value": "max-age=60",
								"description": "Postman adds Cache-Control: no-cache to every request by default, which would bypass the cache. Any value other than no-cache lets the cache serve the request."
							}
						],
						"url": {
							"raw": "{{functionsBaseUrl}}/bom-cost/{{productId}}?quantity={{quantity}}&code={{functionKey}}",
							"host": [
								"{{functionsBaseUrl}}"
							],
							"path": [
								"bom-cost",
								"{{productId}}"
							],
							"query": [
								{
									"key": "quantity",
									"value": "{{quantity}}"
								},
								{
									"key": "code",
									"value": "{{functionKey}}"
								}
							]
						}
					},
					"response": []
				},
				{
