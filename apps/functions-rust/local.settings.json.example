{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "Custom",
    "AzureWebJobsStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=AZURITE_ACCOUNT_KEY_FROM_MICROSOFT_DOCS;BlobEndpoint=http://127.0.0.1:11000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:11001/devstoreaccount1;TableEndpoint=http://127.0.0.1:11002/devstoreaccount1;",
    "ConnectionStrings__AdventureWorks": "Server=tcp:localhost,1433;Database=AdventureWorks;User Id=adventureworks-data-reader;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "ConnectionStrings__Redis": "redis://localhost:6380",
    "BomCache__TtlSeconds": "300",
    "KeyVault__VaultUri": "https://mickkeyvaultwestus.vault.azure.net/",
    "Cosmos__Database": "PlatformDatabases",
    "Cosmos__Container": "bom-cost-results-local",
    "Cosmos__PreferredRegion": "West US 3",
    "BomBatchQueueName": "bom-batch-requests-dev",
    "ServiceBusConnection__fullyQualifiedNamespace": "mick-adventureworks-events.servicebus.windows.net"
  }
}
